# Install as a user service for the OS account whose workspaces/tools ChatGPT may access.
# Suggested repository install path: ~/.local/share/chatgpt-terminal-plugin
# Suggested environment path: ~/.config/chatgpt-terminal-plugin/agent.env
[Unit]
Description=ChatGPT Terminal local agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/chatgpt-terminal-plugin
EnvironmentFile=%h/.config/chatgpt-terminal-plugin/agent.env
# The enrollment token must remain in the EnvironmentFile (mode 0600), never in Environment= lines.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Run the verified built release directly; pnpm is required for install/build, not service runtime.
ExecStart=/usr/bin/env node packages/local-agent/dist/cli.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

# Do not add aggressive filesystem sandboxing here without considering the intended
# terminal access. The agent deliberately runs commands with this user's normal OS
# permissions; use a dedicated OS account/container if stronger containment is needed.

[Install]
WantedBy=default.target
