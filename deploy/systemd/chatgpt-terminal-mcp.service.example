[Unit]
Description=ChatGPT Terminal MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chatgpt-terminal
Group=chatgpt-terminal
WorkingDirectory=/opt/chatgpt-terminal-plugin/current
EnvironmentFile=/etc/chatgpt-terminal/mcp.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Run the verified built release directly; pnpm is required for install/build, not service runtime.
ExecStart=/usr/bin/env node packages/mcp-server/dist/cli.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=mixed
KillSignal=SIGTERM
UMask=0077
StateDirectory=chatgpt-terminal
StateDirectoryMode=0700
LogsDirectory=chatgpt-terminal
LogsDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
