{
  "name": "chatgpt-terminal-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter '!@terminal/terminal-ui' --workspace-concurrency=4 build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run ./tests/unit --exclude '.worktrees/**'",
    "pretest:e2e": "pnpm --filter @terminal/terminal-ui build",
    "test:e2e": "vitest run ./tests/e2e --exclude '.worktrees/**'",
    "start:server": "pnpm --filter @terminal/mcp-server start",
    "start:agent": "pnpm --filter @terminal/local-agent start",
    "dev": "concurrently -k -n mcp,agent,ui 'pnpm --filter @terminal/mcp-server dev' 'pnpm --filter @terminal/local-agent dev' 'pnpm --filter @terminal/terminal-ui dev'",
    "test:soak": "vitest run ./tests/soak --exclude '.worktrees/**' --maxWorkers=1 --testTimeout=120000",
    "prepare": "husky",
    "check": "./scripts/verify.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
